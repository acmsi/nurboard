---
import Layout from "../layouts/Layout.astro";
import { fetchDonationData } from "../lib/donation";
import { fetchMembershipData } from "../lib/membership";

const mawaqitUrl =
  "https://mawaqit.net/fr/m/mosquée-nur-2610-saint-imier-switzerland?showNotification=0&showSearchButton=0&showFooter=0&showFlashMessage=0&view=mobile";

const donationResult = await fetchDonationData();
const donation = donationResult.data;
const donationCurrent = donation.montant_leve;
const donationGoal = donation.objectif;
const donationPercent = donation.pourcentage;
const donationUpdated = new Date(donation.derniere_maj).toLocaleDateString(
  "fr-CH",
  { day: "numeric", month: "long", year: "numeric" },
);
const donationStale = donationResult.isStale || donationResult.isFallback;

const membershipResult = await fetchMembershipData();
const membership = membershipResult.data;
const showMembershipStats = membership !== null;
const membershipStale = membershipResult.isStale;

const membersOutstanding = membership
  ? membership.membres_actifs - membership.membres_a_jour
  : 0;
const membershipPercent = membership
  ? Math.round((membership.membres_a_jour / membership.membres_actifs) * 100)
  : 0;
---

<Layout title="Nurboard">
  <main class="flex h-screen">
    <!-- Left: Mawaqit prayer times widget + app promo overlay -->
    <aside class="w-[515px] shrink-0 relative" style="contain: strict;">
      <iframe
        src={mawaqitUrl}
        title="Horaires de prière - Mawaqit"
        class="w-full h-full border-0 will-change-transform"
        loading="eager"
        sandbox="allow-scripts allow-same-origin"></iframe>
      <!-- Mawaqit app promo (overlaid at bottom) -->
      <div
        class="absolute bottom-0 inset-x-0 flex flex-col items-center gap-4 px-8 py-5 bg-black/90"
      >
        <p class="text-white text-3xl font-medium">
          Horaires sur votre téléphone
        </p>
        <div class="flex items-center justify-center gap-6">
          <img
            src="/qr-mawaqit-app.png"
            alt="QR code application Mawaqit"
            class="w-30 h-30 rounded-lg"
          />
          <div class="flex flex-col gap-3">
            <img
              src="/badge-app-store.svg"
              alt="Download on the App Store"
              class="h-10"
            />
            <img
              src="/badge-google-play.svg"
              alt="Get it on Google Play"
              class="h-10"
            />
          </div>
        </div>
      </div>
    </aside>

    <!-- Right: Dashboard content -->
    <section
      class="flex-1 flex flex-col text-white px-10 pt-6 pb-2 overflow-hidden gap-8 relative bg-nur-teal-950"
    >
      <div
        class="absolute inset-0 islamic-pattern pointer-events-none"
        style="--pattern-background-color: var(--color-nur-teal-950); --pattern-foreground-color: #0a3d3a; mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);"
      >
      </div>
      <!-- Header -->
      <header class="text-center relative z-10">
        <h1 class="font-headings text-7xl font-bold text-nur-cream-200">
          Mosquée Nur
        </h1>
        <p class="text-3xl text-nur-teal-300 mt-2">
          Association Culturelle Musulmane de Saint-Imier
        </p>
      </header>

      <!-- Slideshow -->
      <div class="slideshow-viewport flex-1 overflow-hidden relative z-10">
        <div class="slideshow-track flex h-full gap-10 transition-transform duration-800 ease-in-out">
          <!-- Slide 1: Overview (current two cards) -->
          <div class="slideshow-slide w-full shrink-0 flex flex-col gap-5 justify-center">
            <!-- Membership CTA -->
            <div
              class="bg-nur-teal-900/80 rounded-2xl p-8 flex gap-8 items-center"
            >
              <div class="flex-1">
                <h2
                  class="font-headings text-5xl font-bold text-nur-gold-400 mb-3"
                >
                  Rejoignez l'ACMSI
                </h2>
                <p class="text-3xl text-nur-cream-200 mb-2">
                  Cotisation annuelle&nbsp;: <strong class="text-white"
                    >{showMembershipStats ? membership.cotisation_minimale : 360} CHF</strong
                  > minimum par foyer
                </p>
                <p class="text-3xl text-nur-teal-200 mb-2">
                  Garantissez la pérennité de votre mosquée en devenant membre
                </p>
                <p class="text-3xl text-white font-semibold">
                  {showMembershipStats ? membership.membres_a_jour : "–"} <span class="text-nur-teal-300">/ {showMembershipStats ? membership.membres_actifs : "–"} membres à jour</span>
                </p>
              </div>
              <div class="shrink-0 flex flex-col items-center gap-1">
                <div class="bg-white rounded-2xl overflow-hidden">
                  <img
                    src="/qr-adhesion.svg"
                    alt="QR code adhésion ACMSI"
                    class="w-52 h-52"
                  />
                </div>
                <span class="text-base text-nur-teal-400">acmsi.ch/donation</span>
              </div>
            </div>

            <!-- Xhamia Nur Donation (compact) -->
            <div
              class="bg-nur-teal-900/80 rounded-2xl p-8 flex gap-8 items-center"
            >
              <div class="flex-1">
                <h2
                  class="font-headings text-5xl font-bold text-nur-gold-400 mb-3"
                >
                  Projet Xhamia Nur
                </h2>
                <p class="text-3xl text-nur-cream-200 mb-4">
                  Aidez-nous à racheter notre mosquée
                </p>
                <!-- Progress bar -->
                <div>
                  <div
                    class="w-full h-6 bg-nur-teal-800 rounded-full overflow-hidden"
                  >
                    <div
                      class="h-full bg-nur-gold-500 rounded-full"
                      style={`width: ${donationPercent}%`}
                    >
                    </div>
                  </div>
                  <div
                    class="flex justify-between text-3xl mt-2"
                  >
                    <span class="font-semibold text-nur-gold-400"
                      >{donationCurrent.toLocaleString("fr-CH")} CHF collectés</span
                    >
                    <span class="text-nur-teal-200"
                      >Objectif&nbsp;: {donationGoal.toLocaleString("fr-CH")} CHF</span
                    >
                  </div>
                  <p class="text-3xl text-nur-teal-300 mt-1">
                    {donationPercent.toLocaleString("fr-CH")}% de l'objectif &middot; mis à jour le {
                      donationUpdated
                    }
                  </p>
                  {donationStale && (
                    <p class="text-base text-nur-teal-500 mt-1">&#9888; Données mises en cache</p>
                  )}
                </div>
              </div>
              <div class="shrink-0 flex flex-col items-center gap-1">
                <div class="bg-white rounded-2xl overflow-hidden">
                  <img
                    src="/qr-xhamia-nur.svg"
                    alt="QR code don Xhamia Nur"
                    class="w-52 h-52"
                  />
                </div>
                <span class="text-base text-nur-teal-400"
                  >acmsi.ch/projet-xhamia-nur</span
                >
              </div>
            </div>
          </div>

          <!-- Slide 2: Membership — CTA + optional stats -->
          <div class="slideshow-slide w-full shrink-0 flex flex-col gap-5 justify-center">
            <div
              class="bg-nur-teal-900/80 rounded-2xl p-10 flex gap-10 items-center"
            >
              <div class="flex-1">
                <h2
                  class="font-headings text-5xl font-bold text-nur-gold-400 mb-3"
                >
                  Adhésion à l'ACMSI
                </h2>
                <p class="text-3xl text-nur-cream-200 mb-6">
                  Devenez membre, <strong class="text-nur-gold-400">assurez l'avenir de votre mosquée</strong>
                </p>
                <!-- Benefits list -->
                <ul class="text-3xl text-nur-cream-200 space-y-3 mb-6 list-none">
                  <li class="flex items-start gap-3">
                    <span class="text-nur-gold-400 shrink-0">&#10003;</span>
                    <span>Assurance communautaire pour frais d'enterrement</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="text-nur-gold-400 shrink-0">&#10003;</span>
                    <span>Location salle cafétéria (mariages, enterrements, iftars)</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="text-nur-gold-400 shrink-0">&#10003;</span>
                    <span>Services communautaires dédiés</span>
                  </li>
                </ul>
                <p class="text-3xl text-nur-cream-200 mb-6">
                  Cotisation annuelle&nbsp;: <strong class="text-white">{showMembershipStats ? membership.cotisation_minimale : 360} CHF</strong> minimum par foyer
                </p>
                {showMembershipStats && (
                  <div>
                    <p class="text-5xl font-bold text-white mb-4">
                      {membership.membres_a_jour} <span class="text-nur-teal-300 text-3xl">/ {membership.membres_actifs} membres à jour</span>
                    </p>
                    <!-- Progress bar -->
                    <div class="mb-4">
                      <div
                        class="w-full h-8 bg-nur-teal-800 rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full bg-nur-gold-500 rounded-full"
                          style={`width: ${membershipPercent}%`}
                        >
                        </div>
                      </div>
                    </div>
                    <p class="text-3xl text-nur-cream-200 mb-3">
                      <strong class="text-white">{membersOutstanding} foyers</strong> ne sont pas à jour pour leur cotisation {membership.annee}
                    </p>
                    <p class="text-3xl text-nur-teal-300">
                      {membership.cotisations_recoltees.toLocaleString("fr-CH")} CHF récoltés sur {membership.cotisations_esperees.toLocaleString("fr-CH")} CHF
                    </p>
                    {membershipStale && (
                      <p class="text-base text-nur-teal-500 mt-2">&#9888; Données mises en cache</p>
                    )}
                  </div>
                )}
              </div>
              <div class="shrink-0 flex flex-col items-center gap-1">
                <div class="bg-white rounded-2xl overflow-hidden">
                  <img
                    src="/qr-adhesion.svg"
                    alt="QR code adhésion ACMSI"
                    class="w-52 h-52"
                  />
                </div>
                <span class="text-base text-nur-teal-400">acmsi.ch/donation</span>
              </div>
            </div>
          </div>

          <!-- Slide 3: Xhamia Nur (full) -->
          <div class="slideshow-slide w-full shrink-0 flex flex-col gap-5 justify-center">
            <div class="bg-nur-teal-900/80 rounded-2xl p-10">
              <div class="flex gap-10 items-center">
                <div class="flex-1">
                  <h2
                    class="font-headings text-5xl font-bold text-nur-gold-400 mb-4"
                  >
                    Projet Xhamia Nur
                  </h2>
                  <p class="text-3xl text-nur-cream-200 mb-3">
                    Rachat de notre mosquée sans riba
                  </p>
                  <p class="text-3xl text-nur-cream-200 mb-6">
                    Chaque don compte, <strong class="text-nur-gold-400">contribuez maintenant</strong>
                  </p>
                  <!-- Large progress bar -->
                  <div class="mb-4">
                    <div
                      class="w-full h-10 bg-nur-teal-800 rounded-full overflow-hidden"
                    >
                      <div
                        class="h-full bg-nur-gold-500 rounded-full relative flex items-center"
                        style={`width: ${donationPercent}%`}
                      >
                        <span class="absolute inset-0 flex items-center justify-end pr-3 text-white font-bold text-lg">
                          {donationPercent.toLocaleString("fr-CH")}%
                        </span>
                      </div>
                    </div>
                    <div class="flex justify-between text-3xl mt-2">
                      <span class="font-semibold text-nur-gold-400"
                        >{donationCurrent.toLocaleString("fr-CH")} CHF collectés</span
                      >
                      <span class="text-nur-teal-200"
                        >Objectif&nbsp;: {donationGoal.toLocaleString("fr-CH")} CHF</span
                      >
                    </div>
                  </div>
                  <p class="text-2xl text-nur-teal-400">
                    Mis à jour le {donationUpdated}
                  </p>
                  {donationStale && (
                    <p class="text-base text-nur-teal-500 mt-1">&#9888; Données mises en cache</p>
                  )}
                </div>
                <div class="shrink-0 flex flex-col items-center gap-1">
                  <div class="bg-white rounded-2xl overflow-hidden">
                    <img
                      src="/qr-xhamia-nur.svg"
                      alt="QR code don Xhamia Nur"
                      class="w-52 h-52"
                    />
                  </div>
                  <span class="text-base text-nur-teal-400"
                    >acmsi.ch/projet-xhamia-nur</span
                  >
                </div>
              </div>
              <!-- Cash donation reminder -->
              <div class="flex items-center justify-center gap-4 text-nur-cream-200 mt-4 pt-4 border-t border-nur-teal-700">
                <!-- Donation box icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-nur-gold-400">
                  <path d="M8 18L16 18" stroke="currentColor"></path>
                  <path d="M18.2222 16C18.9126 16.0195 19.3245 16.0918 19.6095 16.3594C20 16.7261 20 17.3162 20 18.4964C20 19.6766 20 20.2667 19.6095 20.6334C19.219 21 18.5904 21 17.3333 21H6.66667C5.40959 21 4.78105 21 4.39052 20.6334C4 20.2667 4 19.6766 4 18.4964C4 17.3162 4 16.7261 4.39052 16.3594C4.67555 16.0918 5.08736 16.0195 5.77778 16" fill="none" stroke="currentColor"></path>
                  <path d="M12 13C10.3431 13 9 14.2792 9 15.8571C9 16.7105 9.39282 17.4765 10.0156 18H13.9844C14.6072 17.4765 15 16.7105 15 15.8571C15 14.2792 13.6569 13 12 13Z" fill="#FBBF24" stroke="currentColor"></path>
                  <path d="M19 10L16.9045 10C16.6472 10 16.3933 9.94201 16.1631 9.83063L14.3764 8.96613C14.1462 8.85475 13.8923 8.79676 13.6349 8.79676L12.7226 8.79676C11.8403 8.79676 11.125 8.10459 11.125 7.25075C11.125 7.21624 11.1486 7.18591 11.1829 7.17643L13.4062 6.56173C13.8051 6.45146 14.2321 6.48987 14.6031 6.66937L16.5132 7.59353M11.125 7.8125L7.10632 9.0472C6.3939 9.26917 5.62381 9.00597 5.17753 8.38799C4.85487 7.94118 4.98625 7.30134 5.45635 7.0301L12.0325 3.23579C12.4507 2.99446 12.9442 2.93558 13.4042 3.0721L19 4.73255" fill="none" stroke="currentColor"></path>
                </svg>
                <p class="text-3xl">
                  Don en espèces&nbsp;: déposez dans la <strong class="text-white">boîte à l'entrée de la salle de prière</strong>
                </p>
              </div>
            </div>
            <!-- Hadith -->
            <div class="text-center space-y-3">
              <p class="text-3xl leading-loose text-nur-cream-200" dir="rtl" lang="ar">
                مَنْ بَنَى مَسْجِدًا يَبْتَغِي بِهِ وَجْهَ اللَّهِ بَنَى اللَّهُ لَهُ مِثْلَهُ فِي الْجَنَّةِ
              </p>
              <p class="text-3xl text-nur-cream-200 italic font-medium">
                &laquo;&nbsp;Celui qui construit une mosquée pour Allah, Allah lui construit son équivalent au Paradis.&nbsp;&raquo;
              </p>
              <p class="text-lg text-nur-teal-400">
                &mdash; Sahih Muslim 533
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide indicators -->
      <div class="flex justify-center gap-4 relative z-10 shrink-0" id="slideshow-indicators">
        <button class="slide-indicator active" aria-label="Slide 1"></button>
        <button class="slide-indicator" aria-label="Slide 2"></button>
        <button class="slide-indicator" aria-label="Slide 3"></button>
      </div>

      <!-- Footer: WhatsApp + acmsi.ch -->
      <div
        class="rounded-2xl p-2 flex items-start justify-center gap-16 relative z-10 shrink-0"
      >
        <div class="flex-1 flex items-start justify-end gap-5">
          <div class="shrink-0 bg-white rounded-2xl overflow-hidden">
            <img
              src="/qr-whatsapp.svg"
              alt="QR code communauté WhatsApp"
              class="w-30 h-30"
            />
          </div>
          <div class="pt-2">
            <p class="text-2xl text-nur-cream-200">Rejoignez-nous sur</p>
            <p
              class="text-4xl font-bold text-green-400 flex items-center gap-3"
            >
              <!-- WhatsApp icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 256 256"
                fill="currentColor"
              >
                <path
                  d="M187.58,144.84l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88,40,40,0,0,0,40-40A8,8,0,0,0,187.58,144.84ZM152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155l14.61-9.74,23,11.48A24,24,0,0,1,152,176ZM128,24A104,104,0,0,0,36.18,176.88L24.83,210.93a16,16,0,0,0,20.24,20.24l34.05-11.35A104,104,0,1,0,128,24Zm0,192a87.87,87.87,0,0,1-44.06-11.81,8,8,0,0,0-6.54-.67L40,216,52.47,178.6a8,8,0,0,0-.66-6.54A88,88,0,1,1,128,216Z"
                ></path>
              </svg>
              WhatsApp
            </p>
          </div>
        </div>
        <div class="w-px self-stretch bg-nur-teal-700"></div>
        <div class="flex-1 flex items-start gap-5">
          <div class="pt-2">
            <p class="text-2xl text-nur-cream-200">Retrouvez-nous sur</p>
            <p class="text-4xl font-bold text-nur-gold-400">acmsi.ch</p>
            <div class="flex gap-3 mt-2 text-nur-teal-300">
              <!-- Facebook icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 256 256"
                fill="currentColor"
              >
                <path
                  d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm8,191.63V152h24a8,8,0,0,0,0-16H136V112a16,16,0,0,1,16-16h16a8,8,0,0,0,0-16H152a32,32,0,0,0-32,32v24H96a8,8,0,0,0,0,16h24v63.63a88,88,0,1,1,16,0Z"
                ></path>
              </svg>
              <!-- Instagram icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 256 256"
                fill="currentColor"
              >
                <path
                  d="M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160ZM176,24H80A56.06,56.06,0,0,0,24,80v96a56.06,56.06,0,0,0,56,56h96a56.06,56.06,0,0,0,56-56V80A56.06,56.06,0,0,0,176,24Zm40,152a40,40,0,0,1-40,40H80a40,40,0,0,1-40-40V80A40,40,0,0,1,80,40h96a40,40,0,0,1,40,40ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"
                ></path>
              </svg>
            </div>
          </div>
          <div class="shrink-0 bg-white rounded-2xl overflow-hidden">
            <img
              src="/qr-acmsi.svg"
              alt="QR code acmsi.ch"
              class="w-30 h-30"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .font-headings {
    font-family: var(--font-family-headings);
  }

  .slide-indicator {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-nur-teal-700);
    border: none;
    padding: 0;
    position: relative;
    cursor: pointer;
    transition: background 0.3s;
  }

  .slide-indicator.active {
    background: var(--color-nur-teal-400);
  }

  @property --ring-progress {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  .slide-indicator::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: conic-gradient(
      var(--color-nur-gold-400) calc(var(--ring-progress) * 1turn),
      transparent 0
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2.5px),
      #000 calc(100% - 2.5px)
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2.5px),
      #000 calc(100% - 2.5px)
    );
    opacity: 0;
  }

  .slide-indicator.active::after {
    opacity: 1;
    animation: indicator-fill 30s steps(30, end) forwards;
  }

  @keyframes indicator-fill {
    to {
      --ring-progress: 1;
    }
  }
</style>

<script>
  const track = document.querySelector(".slideshow-track") as HTMLElement;
  const slides = track?.querySelectorAll(".slideshow-slide");
  const indicators = document.querySelectorAll(".slide-indicator");

  function setActive(index: number) {
    indicators.forEach((ind, i) => {
      if (i === index) {
        ind.classList.remove("active");
        // Force style recalc before re-adding to restart animation
        void (ind as HTMLElement).offsetWidth;
        ind.classList.add("active");
      } else {
        ind.classList.remove("active");
      }
    });
  }

  function goTo(index: number) {
    current = index;
    track.style.transform = `translateX(calc(-${current} * (100% + 2.5rem)))`;
    setActive(current);
    resetTimer();
  }

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(() => {
      current = (current + 1) % slides.length;
      track.style.transform = `translateX(calc(-${current} * (100% + 2.5rem)))`;
      setActive(current);
    }, 30_000);
  }

  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  if (track && slides && slides.length > 1) {
    indicators.forEach((ind, i) => {
      ind.addEventListener("click", () => goTo(i));
    });
    setActive(0);
    resetTimer();
  }
  // Reload Mawaqit iframe when tab becomes hidden (CDP tab switch)
  // to work around memory/rendering issues in the widget
  const mawaqitIframe = document.querySelector("aside iframe") as HTMLIFrameElement;
  if (mawaqitIframe) {
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        const src = mawaqitIframe.src;
        mawaqitIframe.src = "";
        mawaqitIframe.src = src;
      }
    });
  }

  // Reload page every 6h for fresh SSR data
  setTimeout(() => location.reload(), 6 * 3600_000);
</script>

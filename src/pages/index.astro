---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nurboard">
  <main class="dashboard">
    <h1>Mosquee Nur</h1>
    <p class="subtitle">Saint-Imier</p>
  </main>
</Layout>

<style>
  .dashboard {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    color: #fff;
    font-family: system-ui, sans-serif;
  }

  h1 {
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .subtitle {
    font-size: 1.5rem;
    opacity: 0.6;
    margin-top: 0.5rem;
  }
</style>

{
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "build": "deno run -A npm:astro build",
    "start": "deno run -A main.ts",
    "test": "CEC_ENABLED=false deno test --allow-env --allow-read src/lib/"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "path": "node:path",
    "tty": "node:tty",
    "util": "node:util",
    "crypto": "node:crypto",
    "fs": "node:fs",
    "stream": "node:stream",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  }
}

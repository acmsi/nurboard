[Unit]
Description=Nurboard Dashboard Service
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/nurboard
ExecStart=/home/__USER__/.deno/bin/deno run -A main.ts
Restart=always
RestartSec=5
Environment=CEC_ENABLED=true
Environment=CDP_PORT=9222

[Install]
WantedBy=multi-user.target

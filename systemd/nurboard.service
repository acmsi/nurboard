[Unit]
Description=Nurboard Dashboard Service
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/nurboard
ExecStart=/home/__USER__/.deno/bin/deno run -A main.ts
Restart=always
RestartSec=5
Environment=CEC_ENABLED=true
Environment=TV_ON_HOUR=5
Environment=TV_OFF_HOUR=23
Environment=CDP_PORT=9222
Environment=TAB_ROTATION_SECS=300

[Install]
WantedBy=multi-user.target
